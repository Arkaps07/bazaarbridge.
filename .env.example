# Aiven PostgreSQL (System of Record)
PG_URI=

# Aiven Kafka (2 topics x 2 partitions: bazaar.core.events, bazaar.fulfilment.events)
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CA_PATH=
KAFKA_SERVICE_CERT_PATH=
KAFKA_SERVICE_KEY_PATH=

# Aiven OpenSearch (Typo-tolerant discovery index)
OPENSEARCH_URL=
OPENSEARCH_USER=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Authentication & OTP HMAC Secrets (server-side only)
JWT_SECRET=
OTP_HASH_SECRET=
SEED_ADMIN_PASSWORD=

# Optional AI Shopping Assistant (server-side only)
GEMINI_API_KEY=

# Application Server
PORT=3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional Feature Flags (comma-separated)
FEATURE_FLAGS=FEATURE_COUPONS,FEATURE_WISHLIST,FEATURE_ALERTS,FEATURE_ADDRESSES,FEATURE_SAVE_LATER,FEATURE_COMPARE,FEATURE_ASSISTANT,FEATURE_REVIEWS,FEATURE_SUPPORT,FEATURE_SIM_SCREENS
